---
// Elenco degli eventi di un giorno (o del weekend), con i collegamenti alle altre due pagine.
import Base from '../layouts/Base.astro';
import SchedaEvento from './SchedaEvento.astro';
import InvitoSegnala from './InvitoSegnala.astro';
import { jsonLdBriciole } from '../lib/jsonld';
import { SITO, href, urlAssoluto } from '../lib/sito';
import { dataEstesa, eventiDei } from '../lib/giorni';
import { percorsoRegione } from '../lib/luoghi';
import type { Evento } from '../lib/eventi';

interface Props {
  giorni: string[];           // un giorno, oppure sabato e domenica
  percorso: string;           // /oggi/, /domani/, /weekend/
  nome: string;               // "Oggi", "Domani", "Questo weekend"
}
const { giorni, percorso, nome } = Astro.props;
const lista = eventiDei(giorni);
const quando = giorni.length === 1 ? dataEstesa(giorni[0]) : `${dataEstesa(giorni[0])} e ${dataEstesa(giorni[1])}`;
const minuscolo = nome.toLowerCase();
// Per titolo e descrizione: «21–22 novembre 2026» invece delle due date intere (Bing segnala titoli troppo lunghi).
const quandoBreve = giorni.length === 2 && giorni[0].slice(0, 7) === giorni[1].slice(0, 7)
  ? `${Number(giorni[0].slice(8))}–${dataEstesa(giorni[1]).split(' ').slice(1).join(' ')}`
  : quando;
const gratuiti = lista.filter((e) => e.prezzo.tipo === 'gratuito').length;
// Raggruppati per regione, dalla più ricca: al massimo PER_REGIONE schede ciascuna, poi il link alla pagina della regione.
// Prima la pagina conteneva tutti gli eventi (fino a 1.500, oltre 1 MB): pesante sul telefono e poco ordinata.
const PER_REGIONE = 12;
const gruppi = new Map<string, Evento[]>();
for (const e of lista) gruppi.set(e.regioneDati.codiceIstat, [...(gruppi.get(e.regioneDati.codiceIstat) ?? []), e]);
const regioni = [...gruppi.values()].sort((a, b) => b.length - a.length).map((ev) => ({ regione: ev[0].regioneDati, eventi: ev }));
const mostrati = regioni.flatMap((r) => r.eventi.slice(0, PER_REGIONE));
const elencoLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Eventi ${minuscolo}: ${quando}`,
  itemListElement: mostrati.map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: urlAssoluto(e.percorso), name: e.titolo })),
};
---
<Base
  titolo={`Eventi ${minuscolo} in Italia: ${quandoBreve} | ${SITO.nome}`}
  descrizione={`${lista.length.toLocaleString('it-IT')} eventi ${minuscolo} in Italia (${quandoBreve}): concerti, mostre, sagre e visite guidate divisi per regione${gratuiti > 0 ? `, ${gratuiti.toLocaleString('it-IT')} gratuiti` : ''}. Aggiornato ogni ora.`}
  percorso={percorso}
  jsonLd={[jsonLdBriciole([{ nome: `Eventi ${minuscolo}`, percorso }]), elencoLd]}
>
  <section class="apertura">
    <h1>Eventi {minuscolo} in Italia</h1>
    <p class="apertura__testo">
      {quando}. {lista.length > 0
        ? `${lista.length.toLocaleString('it-IT')} eventi in programma${gratuiti > 0 ? `, ${gratuiti} gratuiti` : ''}. Per vederli vicino a te usa «Vicino a me».`
        : 'Non abbiamo ancora eventi per questo giorno: il calendario si aggiorna ogni ora.'}
    </p>
    <div class="scorciatoie">
      <a class="bottone bottone--secondario" href={href('/oggi/')}>Oggi</a>
      <a class="bottone bottone--secondario" href={href('/domani/')}>Domani</a>
      <a class="bottone bottone--secondario" href={href('/weekend/')}>Questo weekend</a>
      <a class="bottone" href={href('/vicino-a-me/')}>Vicino a me</a>
    </div>
  </section>
  {lista.length > 0 && regioni.length > 1 && (
    <nav class="pastiglie" aria-label="Regioni">
      {regioni.map((r) => <a class="pastiglia" href={`#${r.regione.slug}`}>{r.regione.nome} <small>{r.eventi.length}</small></a>)}
    </nav>
  )}
  {lista.length > 0
    ? regioni.map((r) => (
        <section aria-labelledby={r.regione.slug}>
          <h2 id={r.regione.slug}>{r.regione.nome} <small>({r.eventi.length})</small></h2>
          <ul class="elenco">{r.eventi.slice(0, PER_REGIONE).map((e) => <SchedaEvento evento={e} />)}</ul>
          {r.eventi.length > PER_REGIONE && (
            <p><a class="bottone bottone--secondario" href={href(percorsoRegione(r.regione))}>Tutti gli eventi in {r.regione.nome}</a> <small>e altri {r.eventi.length - PER_REGIONE} {minuscolo}: cercali anche con «Vicino a me»</small></p>
          )}
        </section>
      ))
    : <section><h2>In programma</h2><p class="vuoto">Nessun evento per ora. Se ne organizzi uno, segnalalo qui sotto.</p></section>}
  <InvitoSegnala luogo="in Italia" />
</Base>
