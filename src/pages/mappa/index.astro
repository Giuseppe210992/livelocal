---
import Base from '../../layouts/Base.astro';
import Esplora from '../../components/Esplora.astro';
import { SITO } from '../../lib/sito';
---
<Base
  titolo={`Mappa degli eventi a Minturno e dintorni, giorno per giorno | ${SITO.nome}`}
  descrizione="Scegli il giorno e guarda sulla mappa cosa succede a Minturno, Scauri e nelle frazioni. Con la tua posizione vedi gli eventi entro 10, 25, 50 o 100 km."
  percorso="/mappa/"
>
  <section class="apertura">
    <p class="apertura__sopra">Mappa</p>
    <h1>Cosa succede, giorno per giorno</h1>
    <p class="apertura__testo">Scegli il giorno e guarda dove sono gli eventi. Se vuoi, usa la tua posizione per vedere quelli più vicini.</p>
  </section>
  <Esplora />
</Base>
