---
import Base from '../layouts/Base.astro';
import CercaEventi from '../components/CercaEventi.astro';
import SpazioSponsor from '../components/SpazioSponsor.astro';
import Pastiglia from '../components/Pastiglia.astro';
import { prossimi, eventiDellaRegione, eventiDellaProvincia, regioniConEventi, provinceConEventi } from '../lib/eventi';
import { totaleLuoghi } from '../lib/luoghiDaVisitare';
import { percorsoRegione, percorsoProvincia } from '../lib/luoghi';
import { jsonLdSito, jsonLdOrganizzazione } from '../lib/jsonld';
import { SITO, href } from '../lib/sito';

// Solo le regioni con eventi, dalla più ricca.
const regioniOrdinate = regioniConEventi().sort((a, b) => prossimi(eventiDellaRegione(b)).length - prossimi(eventiDellaRegione(a)).length);
---
<Base
  titolo={`${SITO.nome} · Eventi e luoghi da visitare in tutta Italia`}
  descrizione="Cosa fare in Italia: mostre, concerti, sagre e visite guidate giorno per giorno e vicino a te, più i luoghi da visitare con orari e prezzi. Gratis."
  percorso="/"
  jsonLd={[jsonLdSito(), jsonLdOrganizzazione()]}
>
  <section class="apertura apertura--home">
    <h1>Cosa fare vicino a te</h1>
    <p class="apertura__testo">Eventi, mostre, concerti e sagre di tutta Italia, e i luoghi da visitare con orari e prezzi. Gratis, senza registrazione e senza tracciamento.</p>
  </section>

  <SpazioSponsor />

  <CercaEventi />

  <section class="riquadri" aria-label="Altre sezioni">
    <a class="riquadro" href={href('/luoghi/')}>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V10m14 11V10M9 21V10m6 11V10M2 10l10-6 10 6H2Z"/></svg>
      <b>Luoghi da visitare</b><span>Musei, aree archeologiche e castelli: {totaleLuoghi()} luoghi, con mappa</span>
    </a>
    <a class="riquadro" href={href('/mappa/')}>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 4-6 2v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/></svg>
      <b>Mappa degli eventi</b><span>Concerti, mostre e sagre come puntine, per giorno e distanza</span>
    </a>
    <a class="riquadro riquadro--evidenza" href={href('/segnala/')}>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
      <b>Segnala un evento</b><span>Organizzi qualcosa? Dillo in due minuti</span>
    </a>
  </section>


  <details class="sfoglia">
    <summary>Sfoglia per regione e provincia</summary>
    {regioniOrdinate.map((r) => (
      <>
        <h2 class="titoletto"><a href={href(percorsoRegione(r))}>{r.nome}</a> {prossimi(eventiDellaRegione(r)).length > 0 && <small>{prossimi(eventiDellaRegione(r)).length} in programma</small>}</h2>
        <ul class="pastiglie" aria-label={`Province: ${r.nome}`}>
          {provinceConEventi(r).map((p) => <Pastiglia nome={p.nome} percorso={percorsoProvincia(p)} conteggio={prossimi(eventiDellaProvincia(p)).length} />)}
        </ul>
      </>
    ))}
  </details>
</Base>
