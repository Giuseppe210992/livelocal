---
import Base from '../../../../layouts/Base.astro';
import Briciole from '../../../../components/Briciole.astro';
import ElencoEventi from '../../../../components/ElencoEventi.astro';
import Pastiglia from '../../../../components/Pastiglia.astro';
import { province, regione, comuniDi, percorsoRegione, percorsoProvincia, percorsoComune, nomeProvincia, inProvincia } from '../../../../lib/luoghi';
import type { Provincia } from '../../../../lib/luoghi';
import { eventiDellaProvincia, eventiDelComune, prossimi, comuniConPagina } from '../../../../lib/eventi';
import { jsonLdBriciole } from '../../../../lib/jsonld';
import { SITO, href } from '../../../../lib/sito';

export function getStaticPaths() {
  return province.filter((p) => eventiDellaProvincia(p).length > 0).map((p) => ({ params: { regione: regione(p.regione).slug, provincia: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Provincia };
const r = regione(p.regione);
const voci = [
  { nome: r.nome, percorso: percorsoRegione(r) },
  { nome: nomeProvincia(p), percorso: percorsoProvincia(p) },
];
const conPagina = comuniConPagina(comuniDi(p));
---
<Base
  titolo={`Eventi ${inProvincia(p)} (${p.sigla}) | ${SITO.nome}`}
  descrizione={`Cosa fare ${inProvincia(p)}: eventi, sagre, mostre e concerti comune per comune. Calendario gratuito aggiornato ogni ora.`}
  percorso={percorsoProvincia(p)}
  jsonLd={[jsonLdBriciole(voci)]}
>
  <Briciole voci={voci} />
  <section class="apertura">
    <p class="apertura__sopra">{nomeProvincia(p)} · {r.nome}</p>
    <h1>Eventi {inProvincia(p)}</h1>
    {conPagina.length > 0 ? (
      <>
        <p class="apertura__testo">Comuni con eventi in calendario:</p>
        <ul class="pastiglie">
          {conPagina.map((c) => <Pastiglia nome={c.nome} percorso={percorsoComune(c)} conteggio={prossimi(eventiDelComune(c)).length} />)}
        </ul>
      </>
    ) : (
      <p class="apertura__testo">Il calendario {inProvincia(p)} si sta riempiendo. Intanto guarda la <a href={href('/mappa/')}>mappa degli eventi</a>.</p>
    )}
  </section>
  <ElencoEventi lista={eventiDellaProvincia(p)} nomeLuogo={inProvincia(p)} />
</Base>
