---
import Base from '../../../layouts/Base.astro';
import Briciole from '../../../components/Briciole.astro';
import { luoghi } from '../../../lib/luoghiDaVisitare';
import { jsonLdBriciole } from '../../../lib/jsonld';
import { SITO, href } from '../../../lib/sito';

const voci = [{ nome: 'Luoghi da visitare', percorso: '/luoghi/' }, { nome: 'Mappa', percorso: '/luoghi/mappa/' }];
---
<Base
  titolo={`Mappa dei luoghi da visitare: musei, monumenti e castelli | ${SITO.nome}`}
  descrizione="Tutti i luoghi storici e culturali da visitare sulla mappa: musei, aree archeologiche, castelli e palazzi, con orari e costi dalle fonti ufficiali. Cerca vicino a te."
  percorso="/luoghi/mappa/"
  jsonLd={[jsonLdBriciole(voci)]}
>
  <Briciole voci={voci} />
  <section class="apertura apertura--home">
    <p class="apertura__sopra">Storia e cultura</p>
    <h1>Luoghi da visitare sulla mappa</h1>
    <p class="apertura__testo">Musei, aree archeologiche, castelli e palazzi. Tocca un punto per vedere gli orari e aprire la scheda con i costi.</p>
  </section>

  <div class="mappa-luoghi" data-mappa-luoghi data-dati={href('/luoghi.json')} data-comuni={href('/comuni.json')} data-base={href('/')}>
    <noscript><p class="vuoto">La mappa ha bisogno di JavaScript. Puoi comunque vedere l'<a href={href('/luoghi/')}>elenco dei luoghi da visitare</a> ({luoghi.length}).</p></noscript>
    <form class="cerca__form solo-js" data-form role="search">
      <label class="sr-only" for="mappa-testo">Cerca un luogo o un comune</label>
      <input id="mappa-testo" class="cerca__campo" data-testo type="search" list="mappa-comuni" autocomplete="off" enterkeyhint="search" placeholder="Luogo o comune" />
      <datalist id="mappa-comuni" data-comuni-lista></datalist>
      <button type="button" class="bottone" data-gps>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="7.5"/></svg>
        Vicino a me
      </button>
    </form>
    <div class="filtri filtri--scorri solo-js" data-tipi role="group" aria-label="Tipo di luogo"></div>
    <div class="mappa mappa--luoghi" data-mappa role="region" aria-label="Mappa dei luoghi da visitare"></div>
    <p class="cerca__stato" aria-live="polite"><span data-stato>Carico i luoghi…</span> <button type="button" class="cerca__azzera" data-azzera hidden>Azzera filtri</button></p>
    <h2 class="titoletto" data-titolo-lista hidden>Luoghi in questa zona</h2>
    <ul class="elenco" data-lista></ul>
    <p class="privacy-posizione">La posizione si usa solo se tocchi «Vicino a me» e resta sul tuo telefono. Dove la scheda dice «posizione indicativa», il punto è il centro del paese. Mappa: © OpenStreetMap.</p>
    <p><a class="bottone bottone--secondario" href={href('/luoghi/')}>Elenco dei luoghi</a></p>
  </div>
</Base>

<script>import '../../../scripts/mappa-luoghi.ts';</script>
