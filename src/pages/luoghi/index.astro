---
import Base from '../../layouts/Base.astro';
import Briciole from '../../components/Briciole.astro';
import SchedaLuogo from '../../components/SchedaLuogo.astro';
import { luoghi, regioniConLuoghi, provinceConLuoghi, luoghiDellaProvincia } from '../../lib/luoghiDaVisitare';
import { nomeProvincia } from '../../lib/luoghi';
import { jsonLdBriciole } from '../../lib/jsonld';
import { SITO, href } from '../../lib/sito';

const voci = [{ nome: 'Luoghi da visitare', percorso: '/luoghi/' }];
---
<Base
  titolo={`Luoghi da visitare: musei, aree archeologiche e monumenti | ${SITO.nome}`}
  descrizione="Musei, aree archeologiche, castelli e palazzi storici aperti al pubblico, con orari e prezzi presi dalle fonti ufficiali e la data dell'ultimo controllo."
  percorso="/luoghi/"
  jsonLd={[jsonLdBriciole(voci)]}
>
  <Briciole voci={voci} />
  <section class="apertura">
    <p class="apertura__sopra">Storia e cultura</p>
    <h1>Luoghi da visitare</h1>
    <p class="apertura__testo">Musei, aree archeologiche, castelli e palazzi aperti al pubblico. Per ognuno trovi dove si trova, gli orari e il costo del biglietto, copiati dal sito ufficiale, con la data in cui li abbiamo controllati.</p>
  </section>

  {regioniConLuoghi().map((r) => (
    <>
      <h2 class="titoletto">{r.nome}</h2>
      {provinceConLuoghi(r).map((p) => (
        <section aria-labelledby={`prov-${p.slug}`}>
          <h3 id={`prov-${p.slug}`} class="sottotitolo">{nomeProvincia(p)}</h3>
          <ul class="elenco">{luoghiDellaProvincia(p).map((l) => <SchedaLuogo luogo={l} />)}</ul>
        </section>
      ))}
    </>
  ))}

  <section class="nota" aria-labelledby="titolo-mancano">
    <h2 id="titolo-mancano" style="margin-top:0;font-size:1.05rem">Stiamo aggiungendo i luoghi zona per zona</h2>
    <p>Per ora ci sono {luoghi.length} luoghi, quelli di cui abbiamo già controllato orari e prezzi su fonti ufficiali. Ne manca uno che conosci? Scrivicelo: lo controlliamo e lo aggiungiamo.</p>
    <p><a class="bottone bottone--secondario" href={href('/segnala/')}>Segnala un luogo o un evento</a></p>
  </section>
</Base>
